---
interface Props {
	dot?: boolean;
	as?: string;
	class?: string;
}
const { dot = true, as: Tag = 'p', class: className } = Astro.props;
---

<Tag class:list={['flex items-center gap-2 font-mono text-[.66rem] tracking-[.1em] text-steel uppercase', className]}>
	{dot && <span class="inline-block size-[7px] rounded-[1px] bg-red"></span>}
	<slot />
</Tag>
