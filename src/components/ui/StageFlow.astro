---
import { phases } from '../../lib/phases';

interface Props {
	class?: string;
}
const { class: className } = Astro.props;

const tones = {
	sky: { box: 'border-sky bg-sky/17', num: 'text-sky' },
	orange: { box: 'border-orange bg-orange/17', num: 'text-orange' },
	teal: { box: 'border-teal bg-teal/18', num: 'text-teal' },
	red: { box: 'border-red bg-red/10', num: 'text-red' },
	green: { box: 'border-green bg-green/15', num: 'text-green' },
};
const arrows =
	"not-last:before:absolute not-last:before:top-1/2 not-last:before:-right-[26px] not-last:before:h-0.5 not-last:before:w-[26px] not-last:before:-translate-y-1/2 not-last:before:bg-steel not-last:before:content-[''] " +
	"not-last:after:absolute not-last:after:top-1/2 not-last:after:-right-[26px] not-last:after:-translate-y-1/2 not-last:after:border-y-[5px] not-last:after:border-l-[7px] not-last:after:border-y-transparent not-last:after:border-l-steel not-last:after:content-['']";
---

<div class:list={['overflow-x-auto pt-[3px] pb-[9px]', className]}>
	<div class="mx-auto grid w-[min(1300px,100%)] min-w-[980px] grid-cols-5 gap-[26px] max-md:min-w-[900px]" role="list" aria-label="ProteomIQon processing stages">
		{phases.map((phase) => (
			<div class:list={['relative min-w-0', arrows]} role="listitem">
				<div class:list={['min-h-[124px] rounded-lg border-2 px-[15px] pt-4 pb-[15px] text-navy', tones[phase.tone].box]}>
					<span class:list={['block font-mono text-[.68rem] tracking-[.08em]', tones[phase.tone].num]}>{phase.number}</span>
					<strong class="mt-3.5 mb-2 block text-[clamp(.9rem,1.05vw,1rem)] leading-[1.15] text-navy">{phase.label}</strong>
					<small class="block text-[clamp(.65rem,.78vw,.74rem)] leading-normal text-steel">{phase.detail}</small>
				</div>
			</div>
		))}
	</div>
</div>
