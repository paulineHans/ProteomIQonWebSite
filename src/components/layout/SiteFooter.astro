---
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<footer class:list={['mx-auto flex w-[min(1180px,calc(100%-48px))] justify-between gap-5 border-t border-line pt-[22px] pb-[34px] text-xs text-steel max-md:block max-md:w-[min(100%-32px,640px)]', className]}>
	<div class="flex gap-2">
		<strong class="text-navy">ProteomIQon</strong>
	</div>
	<a class="text-red! no-underline max-md:mt-2.5 max-md:block" href="https://github.com/CSBiology/ProteomIQon/">View the project on GitHub ↗</a>
</footer>
