---
import { withBase } from '../../lib/site';
import Brand from './Brand.astro';

interface Props {
	class?: string;
}
const { class: className } = Astro.props;

const navigation = [
	{ href: withBase('/guide/getting-started/'), label: 'Getting started', quiet: false },
	{ href: withBase('/guide/installation/'), label: 'Installation', quiet: false },
	{ href: withBase('/tools/'), label: 'Tools', quiet: false },
	{ href: withBase('/guide/further-information/'), label: 'Learn more', quiet: false },
	{ href: withBase('/guide/help/'), label: 'Help', quiet: true },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href);

const link = 'group relative py-1 text-[.8rem] whitespace-nowrap no-underline transition-colors duration-200 hover:text-navy!';
---

<header class:list={['mx-auto flex w-[min(1180px,calc(100%-48px))] items-center justify-between gap-x-6 border-b border-line pt-6 pb-5 max-md:w-[min(100%-32px,640px)] max-[520px]:block', className]}>
	<Brand />
	<nav class="flex items-center gap-[25px] max-[520px]:mt-[18px] max-[520px]:flex-wrap max-[520px]:gap-x-4 max-[520px]:gap-y-2" aria-label="Main navigation">
		{navigation.map((item) => {
			const active = isCurrent(item.href);
			return (
				<a
					class:list={[link, item.quiet ? 'text-red!' : active ? 'text-navy!' : 'text-steel!']}
					href={item.href}
					aria-current={active ? 'page' : undefined}
				>
					{item.label}
					<span class:list={['absolute inset-x-0 bottom-0 h-0.5 origin-right scale-x-0 bg-red transition-transform duration-200 group-hover:origin-left group-hover:scale-x-100', active && 'origin-left scale-x-100']}></span>
				</a>
			);
		})}
	</nav>
</header>
