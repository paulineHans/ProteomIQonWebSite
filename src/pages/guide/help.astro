---
import LegacyPage from '../../components/LegacyPage.astro';
import Layout from '../../layouts/Layout.astro';
import { readLegacyPage } from '../../lib/legacyContent';

const page = readLegacyPage('help.html', 'Help');
---

<Layout title="Help · ProteomIQon" description="Get help, report issues and contribute to ProteomIQon.">
	<LegacyPage title={page.title} eyebrow="Community" intro="Report a bug, share an idea or find the contributors who can help you move forward." html={page.html} />
</Layout>
