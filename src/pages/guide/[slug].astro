---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const guides = await getCollection('guides');
	return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, eyebrow, intro, description, contributors } = entry.data;
---

<Layout title={`${title} · ProteomIQon`} description={description}>
	<section class="page-hero compact-page-hero">
		<div>
			<p class="eyebrow"><span class="eyebrow-dot"></span>{eyebrow}</p>
			<h1>{title}</h1>
			<p class="page-intro">{intro}</p>
		</div>
	</section>

	<div class="content-column">
		<article class="legacy-content">
			<Content />
			{contributors && (
				<ul class="contributor-list">
					{contributors.map((person) => (
						<li>
							<strong>{person.url ? <a href={person.url} target="_blank" rel="noopener">{person.name}</a> : person.name}</strong>
							{person.role && <span>{person.role}</span>}
							{person.image && <Image src={person.image} alt={`Portrait of ${person.name}`} width={160} />}
						</li>
					))}
				</ul>
			)}
		</article>
	</div>
</Layout>
