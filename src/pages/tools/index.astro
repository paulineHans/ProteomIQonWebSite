---
import Layout from '../../layouts/Layout.astro';
import { phases } from '../../lib/phases';
import { getSortedTools, toolHref } from '../../lib/tools';
import { withBase } from '../../lib/site';
import { breakCamelCase } from '../../lib/text';

const tools = await getSortedTools();
const toolsOf = (phaseId: string) => tools.filter((tool) => tool.data.phase === phaseId);
---

<Layout title="Tools · ProteomIQon" description="Browse the ProteomIQon tools by processing stage.">
	<section class="page-hero tools-hero">
		<div>
			<p class="eyebrow"><span class="eyebrow-dot"></span> The tool directory</p>
			<h1>One pipeline.<br /><em>Many focused tools.</em></h1>
			<p class="page-intro">Each tool has one job. Explore the details, inputs and hand-offs that make up the ProteomIQon workflow.</p>
		</div>
		<div class="tool-count"><strong>{tools.length}</strong><span>documented<br />tools</span></div>
	</section>
	<section class="tool-directory" aria-labelledby="directory-title">
		<div class="directory-header">
			<div><p class="eyebrow">Navigate by stage</p><h2 id="directory-title">Find the right step for your data.</h2></div>
			<label class="tool-search"><span aria-hidden="true">⌕</span><span class="sr-only">Search tools</span><input id="tool-search" type="search" placeholder="Search tools" autocomplete="off" /></label>
		</div>

		<div class="phase-groups">
			{phases.map((phase) => (
				<section class:list={['phase-group', `phase-${phase.id}`]} aria-labelledby={`phase-${phase.id}`}>
					<div class="phase-heading"><h3 id={`phase-${phase.id}`}>{phase.label}</h3><span>{toolsOf(phase.id).length} tools</span></div>
					<div class="tool-grid">
						{toolsOf(phase.id).map((tool) => (
							<a class="tool-card" data-tool-card data-search={`${tool.data.name} ${tool.data.summary} ${phase.label}`} href={toolHref(tool.id)}>
								<div class="tool-card-topline"><span>{phase.number} / {phase.label}</span><span>↗</span></div><h4>{breakCamelCase(tool.data.name).map((part, i) => (<Fragment>{i > 0 && <wbr />}{part}</Fragment>))}</h4><p>{tool.data.summary}</p>
							</a>
						))}
					</div>
				</section>
			))}
		</div>
		<p class="no-results" id="no-results" hidden>No tools match that search. Try a shorter term.</p>
	</section>
</Layout>

<script>
	const searchInput = document.querySelector<HTMLInputElement>('#tool-search');
	const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-tool-card]'));
	const noResults = document.querySelector<HTMLElement>('#no-results');
	searchInput?.addEventListener('input', () => {
		const query = searchInput.value.trim().toLowerCase();
		let visible = 0;
		cards.forEach((card) => {
			const matches = !query || card.dataset.search?.toLowerCase().includes(query);
			card.hidden = !matches;
			if (matches) visible += 1;
		});
		if (noResults) noResults.hidden = visible !== 0;
	});
</script>
