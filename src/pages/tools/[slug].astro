---
import Layout from '../../layouts/Layout.astro';
import { readToolPage } from '../../lib/legacyContent';
import { tools, type Tool } from '../../data/tools';

export function getStaticPaths() {
	return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props as { tool: Tool };
const page = readToolPage(tool.source, tool.name);
const toolIndex = tools.findIndex((candidate) => candidate.slug === tool.slug);
const previousTool = tools[toolIndex - 1];
const nextTool = tools[toolIndex + 1];
const hasLongToolTitle = tool.name === 'PeptideSpectrumMatchingTIMs';
const phaseClass = (phase: string) => phase.toLowerCase().replace(/\s+/g, '-');
---

<Layout title={`${tool.name} · ProteomIQon`} description={tool.summary}>
	<div class:list={['tool-detail-layout', `phase-${phaseClass(tool.phase)}`]}>
		<aside class="tool-sidebar">
			<a class="back-link" href="/tools/">← All tools</a><div class="sidebar-rule"></div><p class="sidebar-label">In this stage</p>
			<nav aria-label={`${tool.phase} tools`}>
				{tools.filter((candidate) => candidate.phase === tool.phase).map((candidate) => (
					<a class:list={{ active: candidate.slug === tool.slug }} href={`/tools/${candidate.slug}/`}>{candidate.name}</a>
				))}
			</nav>
		</aside>

		<main class="tool-detail">
			<section class="tool-detail-hero"><p class="eyebrow"><span class="eyebrow-dot"></span> {tool.phaseNumber} / {tool.phase}</p><h1 class:list={{ 'long-tool-title': hasLongToolTitle }}>{hasLongToolTitle ? <>PeptideSpectrumMatching<wbr />TIMs</> : tool.name}</h1><p class="tool-summary">{tool.summary}</p></section>
			<article class="legacy-content tool-legacy-content" set:html={page.html}></article>
			<nav class="tool-pagination" aria-label="Browse tools">
				{previousTool ? <a href={`/tools/${previousTool.slug}/`}><small>Previous tool</small><span>← {previousTool.name}</span></a> : <span></span>}
				{nextTool ? <a class="next" href={`/tools/${nextTool.slug}/`}><small>Next tool</small><span>{nextTool.name} →</span></a> : <a class="next" href="/tools/"><small>Directory</small><span>Back to all tools →</span></a>}
			</nav>
		</main>
	</div>
</Layout>
