---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getPhase } from '../../lib/phases';
import { getSortedTools, toolHref } from '../../lib/tools';
import { withBase } from '../../lib/site';

export async function getStaticPaths() {
	const tools = await getSortedTools();
	return tools.map((entry, index) => ({
		params: { slug: entry.id },
		props: { entry, previousTool: tools[index - 1], nextTool: tools[index + 1], siblings: tools.filter((tool) => tool.data.phase === entry.data.phase) },
	}));
}

const { entry, previousTool, nextTool, siblings } = Astro.props;
const { Content } = await render(entry);
const phase = getPhase(entry.data.phase);
---

<Layout title={`${entry.data.name} · ProteomIQon`} description={entry.data.summary}>
	<div class:list={['tool-detail-layout', `phase-${phase.id}`]}>
		<aside class="tool-sidebar">
			<a class="back-link" href={withBase('/tools/')}>← All tools</a><div class="sidebar-rule"></div><p class="sidebar-label">In this stage</p>
			<nav aria-label={`${phase.label} tools`}>
				{siblings.map((candidate) => (
					<a class:list={{ active: candidate.id === entry.id }} href={toolHref(candidate.id)}>{candidate.data.name}</a>
				))}
			</nav>
		</aside>

		<main class="tool-detail">
			<section class="tool-detail-hero"><p class="eyebrow"><span class="eyebrow-dot"></span> {phase.number} / {phase.label}</p><h1>{entry.data.name}</h1><p class="tool-summary">{entry.data.summary}</p></section>
			<article class="legacy-content tool-legacy-content"><Content /></article>
			<nav class="tool-pagination" aria-label="Browse tools">
				{previousTool ? <a href={toolHref(previousTool.id)}><small>Previous tool</small><span>← {previousTool.data.name}</span></a> : <span></span>}
				{nextTool ? <a class="next" href={toolHref(nextTool.id)}><small>Next tool</small><span>{nextTool.data.name} →</span></a> : <a class="next" href={withBase('/tools/')}><small>Directory</small><span>Back to all tools →</span></a>}
			</nav>
		</main>
	</div>
</Layout>
