---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/site';
import Banner from '../components/ui/Banner.astro';
import Button from '../components/ui/Button.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import EntryCard from '../components/ui/EntryCard.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import StageFlow from '../components/ui/StageFlow.astro';
import TextLink from '../components/ui/TextLink.astro';

const entryPoints = [
	{ number: '01', title: 'Explore the tools', text: 'Browse each processing step, from mzML conversion to protein inference and quantification.', href: withBase('/tools/'), label: '18 tools in the directory', tone: 'red' },
	{ number: '02', title: 'Install the pipeline', text: 'Set up the complete pipeline or install individual .NET tools from NuGet.', href: withBase('/guide/installation/'), label: 'Installation guide', tone: 'sky' },
	{ number: '03', title: 'Get started', text: 'Find the first steps for running ProteomIQon as a beginner or advanced user.', href: withBase('/guide/getting-started/'), label: 'Start here', tone: 'green' },
	{ number: '04', title: 'Understand the system', text: 'Learn how tools are built, connected, documented and published.', href: withBase('/guide/further-information/'), label: 'Developer notes', tone: 'orange' },
	{ number: '05', title: 'Find support', text: 'Report issues, contribute ideas or connect with the people behind the project.', href: withBase('/guide/help/'), label: 'Community & help', tone: 'teal' },
] as const;
---

<Layout title="ProteomIQon · Proteomics toolchain" description="Explore the ProteomIQon toolchain, its processing tools, documentation and its tutorials." showFooter={false}>
	<div>
		<Banner>This website is a construction site and not finished yet</Banner>
		<section class="relative overflow-hidden pt-[78px] pb-[70px] min-h-[575px] max-md:min-h-0 max-md:pt-14 max-md:pb-12 max-[520px]:pt-[47px]">
			<div class="relative z-2 w-[min(630px,100%)]">
				<Eyebrow>Open-source proteomics toolchain</Eyebrow>
				<h1 class="mb-6 text-[clamp(3rem,6.2vw,5.75rem)]! [text-shadow:0_0_18px_rgba(247,249,251,.92),0_2px_0_rgba(247,249,251,.72)]">Proteom<em class="text-steel not-italic">IQ</em>on</h1>
				<p class="max-w-[570px] text-[1.07rem] leading-[1.75] text-steel max-[520px]:text-base">a modular collection of tools for moving from mass-spectrometry data to identifications and quantitative results.</p>
				<div class="mt-[33px] flex flex-wrap items-center gap-6 max-[520px]:flex-col max-[520px]:items-start max-[520px]:gap-[18px]">
					<Button href={withBase('/guide/getting-started/')}>New here? Start with the guide</Button>
				</div>
			</div>
			<div class="pointer-events-none absolute top-[42%] right-0 z-1 aspect-[1630/756] w-[min(700px,62vw)] -translate-y-1/2 opacity-[.34] max-md:relative max-md:top-auto max-md:right-auto max-md:mx-auto max-md:-mt-2.5 max-md:w-[min(100%,410px)] max-md:translate-y-0 max-[520px]:w-[calc(100vw-32px)]" aria-label="A diagram showing data moving through a proteomics pipeline">
				<img class="block size-full object-contain object-center" src={withBase('/images/PillarsOfCompProt.png')} alt="ProteomIQon" />
			</div>
		</section>

		<section class="border-y border-line pt-[34px] pb-10" aria-labelledby="pipeline-title">
			<div class="mb-[27px] font-mono text-[.72rem] tracking-[.13em] text-steel uppercase" id="pipeline-title">A modular path through the data</div>
			<StageFlow />
		</section>

		<section class="pt-[108px] pb-[68px] max-md:pt-[76px] max-md:pb-[51px]" aria-labelledby="entry-title">
			<SectionHeading
				eyebrow="Choose your next step"
				title="Overview."
				id="entry-title"
				note="Five entry points keep the documentation focused, whether you are running a workflow or building a new tool."
			/>
			<nav class="grid grid-cols-5 gap-3 max-md:grid-cols-2 max-[520px]:grid-cols-1" aria-label="Documentation sections">
				{entryPoints.map((entry) => <EntryCard {...entry} />)}
			</nav>
		</section>

		<section class="grid grid-cols-[1fr_1.4fr_1fr] items-center gap-[25px] border-t border-line pt-7 pb-[72px] max-md:block max-md:pb-[54px]">
			<div class="grid gap-[13px]">
				<Eyebrow class="mb-0">Built for reproducible research</Eyebrow>
				<strong class="text-[.8rem] text-navy">ProteomIQon</strong>
			</div>
			<p class="max-w-[390px] text-[.86rem] text-steel max-md:my-[19px]!">Follow one tool at a time, or use the whole chain. The documentation mirrors the way the analysis is assembled.</p>
			<TextLink href="https://github.com/CSBiology/ProteomIQon/" external class="max-md:inline-block">View the project on GitHub</TextLink>
		</section>
	</div>
</Layout>
