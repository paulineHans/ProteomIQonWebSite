---
import Layout from '../layouts/Layout.astro';

const entryPoints = [
	{ number: '01', title: 'Explore the tools', text: 'Browse each processing step, from mzML conversion to protein inference and quantification.', href: '/tools/', label: '18 tools in the directory', className: 'coral' },
	{ number: '02', title: 'Install the pipeline', text: 'Set up the complete pipeline or install individual .NET tools from NuGet.', href: '/guide/installation/', label: 'Installation guide', className: 'blue' },
	{ number: '03', title: 'Get started', text: 'Find the first steps for running ProteomIQon as a beginner or advanced user.', href: '/guide/getting-started/', label: 'Start here', className: 'lime' },
	{ number: '04', title: 'Understand the system', text: 'Learn how tools are built, connected, documented and published.', href: '/guide/further-information/', label: 'Developer notes', className: 'gold' },
	{ number: '05', title: 'Find support', text: 'Report issues, contribute ideas or connect with the people behind the project.', href: '/guide/help/', label: 'Community & help', className: 'violet' },
];

const stages = [
	{ number: '01', label: 'Prepare', detail: 'mzML · peptide database' },
	{ number: '02', label: 'Identify', detail: 'spectrum matching · FDR' },
	{ number: '03', label: 'Infer', detail: 'protein groups' },
	{ number: '04', label: 'Quantify', detail: 'alignment · protein intensity' },
];
---

<Layout title="ProteomIQon · Proteomics toolchain" description="Explore the ProteomIQon proteomics toolchain, its processing tools and documentation.">
	<div class="home-page">
		<section class="hero home-hero">
			<div class="hero-copy">
				<p class="eyebrow"><span class="eyebrow-dot"></span> Open proteomics toolchain</p>
				<h1>Turn complex spectra into <em>clear answers.</em></h1>
				<p class="hero-lede">ProteomIQon is a modular collection of tools for moving from raw mass-spectrometry data to identifications, protein groups and quantitative results.</p>
				<div class="hero-actions">
					<a class="button button-primary" href="/tools/">Explore the toolchain <span>↗</span></a>
					<a class="text-link" href="/guide/getting-started/">New here? Start with the guide <span>→</span></a>
				</div>
			</div>
			<div class="hero-visual" aria-label="A diagram showing data moving through a proteomics pipeline">
				<div class="visual-orbit orbit-one"></div><div class="visual-orbit orbit-two"></div><div class="visual-grid"></div>
				<div class="visual-node node-top"><span>MS</span><small>raw signal</small></div>
				<div class="visual-node node-center"><span>IQ</span><small>pipeline</small></div>
				<div class="visual-node node-bottom"><span>∑</span><small>insight</small></div>
				<div class="visual-path path-one"></div><div class="visual-path path-two"></div>
				<div class="visual-label label-one">spectra</div><div class="visual-label label-two">quantification</div>
			</div>
		</section>

		<section class="pipeline-strip" aria-labelledby="pipeline-title">
			<div class="section-label" id="pipeline-title">A modular path through the data</div>
			<div class="stage-list">
				{stages.map((stage, index) => (
					<div class="stage" class:has-connector={index < stages.length - 1}>
						<span class="stage-number">{stage.number}</span><div><strong>{stage.label}</strong><small>{stage.detail}</small></div>
					</div>
				))}
			</div>
		</section>

		<section class="entry-section" aria-labelledby="entry-title">
			<div class="section-heading">
				<div><p class="eyebrow">Choose your next step</p><h2 id="entry-title">Everything you need, one layer deeper.</h2></div>
				<p class="section-note">Five entry points keep the documentation focused, whether you are running a workflow or building a new tool.</p>
			</div>
			<nav class="entry-grid" aria-label="Documentation sections">
				{entryPoints.map((entry) => (
					<a class:list={['entry-card', entry.className]} href={entry.href}>
						<div class="entry-topline"><span>{entry.number}</span><span class="entry-arrow">↗</span></div>
						<h3>{entry.title}</h3><p>{entry.text}</p><span class="entry-label">{entry.label}</span>
					</a>
				))}
			</nav>
		</section>

		<section class="home-footer-note">
			<p class="eyebrow">Built for reproducible research</p>
			<p>Follow one tool at a time, or use the whole chain. The documentation mirrors the way the analysis is assembled.</p>
			<a class="text-link" href="https://github.com/CSBiology/ProteomIQon/">Read the source on GitHub <span>↗</span></a>
		</section>
	</div>
</Layout>
