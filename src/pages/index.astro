---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/site';

const entryPoints = [
	{ number: '01', title: 'Explore the tools', text: 'Browse each processing step, from mzML conversion to protein inference and quantification.', href: withBase('/tools/'), label: '18 tools in the directory', className: 'coral' },
	{ number: '02', title: 'Install the pipeline', text: 'Set up the complete pipeline or install individual .NET tools from NuGet.', href: withBase('/guide/installation/'), label: 'Installation guide', className: 'blue' },
	{ number: '03', title: 'Get started', text: 'Find the first steps for running ProteomIQon as a beginner or advanced user.', href: withBase('/guide/getting-started/'), label: 'Start here', className: 'lime' },
	{ number: '04', title: 'Understand the system', text: 'Learn how tools are built, connected, documented and published.', href: withBase('/guide/further-information/'), label: 'Developer notes', className: 'gold' },
	{ number: '05', title: 'Find support', text: 'Report issues, contribute ideas or connect with the people behind the project.', href: withBase('/guide/help/'), label: 'Community & help', className: 'violet' },
];

const stages = [
	{ number: '01', label: 'Preprocessing', detail: 'mzML · mzlite · peptide database', tone: 'sky' },
	{ number: '02', label: 'Peptide Identification', detail: 'spectrum matching · FDR', tone: 'orange' },
	{ number: '03', label: 'Peptide Quantification', detail: 'XIC · intensity', tone: 'teal' },
	{ number: '04', label: 'Protein Identification', detail: 'protein groups', tone: 'red' },
	{ number: '05', label: 'Protein Quantification', detail: 'alignment · protein intensity', tone: 'green' },
];
---

<Layout title="ProteomIQon · Proteomics toolchain" description="Explore the ProteomIQon toolchain, its processing tools, documentation and its tutorials." showFooter={false}>
	<div class="home-page">
		<div class="construction-banner" role="status">This website is a construction site and not finished yet</div>
		<section class="hero home-hero">
			<div class="hero-copy">
				<p class="eyebrow"><span class="eyebrow-dot"></span> Open-source proteomics toolchain</p>
				<h1>Proteom<em>IQ</em>on</h1>
				<p class="hero-lede">a modular collection of tools for moving from mass-spectrometry data to identifications and quantitative results.</p>
				<div class="hero-actions">
					<a class="button button-primary" href={withBase('/guide/getting-started/')}>New here? Start with the guide <span>→</span></a>
				</div>
			</div>
			<div class="hero-visual" aria-label="A diagram showing data moving through a proteomics pipeline">
				<img src={withBase('/images/PillarsOfCompProt.png')} alt="ProteomIQon"/>
			</div>
		</section>

		<section class="pipeline-strip" aria-labelledby="pipeline-title">
			<div class="section-label" id="pipeline-title">A modular path through the data</div>
			<div class="stage-flow-scroll">
				<div class="stage-flow" role="list" aria-label="ProteomIQon processing stages">
					{stages.map((stage) => (
						<div class:list={['stage-flow-item', `flow-stage-${stage.tone}`]} role="listitem">
							<div class="flow-stage">
								<span class="flow-stage-number">{stage.number}</span>
								<strong>{stage.label}</strong>
								<small>{stage.detail}</small>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="entry-section" aria-labelledby="entry-title">
			<div class="section-heading">
				<div><p class="eyebrow">Choose your next step</p><h2 id="entry-title">Overview.</h2></div>
				<p class="section-note">Five entry points keep the documentation focused, whether you are running a workflow or building a new tool.</p>
			</div>
			<nav class="entry-grid" aria-label="Documentation sections">
				{entryPoints.map((entry) => (
					<a class:list={['entry-card', entry.className]} href={entry.href}>
						<div class="entry-topline"><span>{entry.number}</span><span class="entry-arrow">↗</span></div>
						<h3>{entry.title}</h3><p>{entry.text}</p><span class="entry-label">{entry.label}</span>
					</a>
				))}
			</nav>
		</section>

		<section class="home-footer-note">
			<div class="home-footer-branding">
				<p class="eyebrow">Built for reproducible research</p>
				<strong>ProteomIQon</strong>
			</div>
			<p>Follow one tool at a time, or use the whole chain. The documentation mirrors the way the analysis is assembled.</p>
			<a class="text-link" href="https://github.com/CSBiology/ProteomIQon/">View the project on GitHub <span>↗</span></a>
		</section>
	</div>
</Layout>
